{
  "name": "keysense",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "samples": "node scripts/fetch-samples.mjs",
    "desktop": "npm run build && electron .",
    "desktop:build": "npm run samples && npm run build && electron-builder --publish never",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "icons": "node scripts/make-icons.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run check:i18n && npm run check:contrast && npm run test",
    "desktop:build:win": "npm run samples && npm run build && electron-builder --win --publish never",
    "desktop:build:linux": "npm run samples && npm run build && electron-builder --linux --publish never",
    "check:i18n": "node scripts/check-i18n.mjs",
    "i18n:extract": "node scripts/check-i18n.mjs --write"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "dexie": "^4.4.5",
    "dexie-react-hooks": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "smplr": "^1.0.0",
    "tonal": "^6.4.3",
    "ts-fsrs": "^5.4.2",
    "vexflow": "^5.0.0",
    "webmidi": "^3.1.16",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "description": "Understand the keyboard. Play anything.",
  "author": "Keysense",
  "main": "electron/main.cjs",
  "homepage": "https://github.com/lihogloglo/Open-Piano-Training"
}
